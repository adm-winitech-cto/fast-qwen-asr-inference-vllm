# Docker runtime environment variables (offline/local-model mode)
# This file is consumed by: make up (docker --env-file)

# Force offline behavior (no network fetch from HF)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# Optional legacy overrides (use only if needed):
# ASR_MODEL_PATH=/data/shared/Qwen3-ASR/models/1.7b-v2-cp47728
# ALIGNER_MODEL_PATH=/data/shared/Qwen3-ASR/models/0.6b-v3-cp22426
# LOCAL_FILES_ONLY=true
# FORCE_OFFLINE=true

# Example prefixed overrides:
# APP_CFG__SERVER__PORT=8000
# APP_CFG__STREAMING__STREAM_MIN_SAMPLES=3200
# APP_CFG__CONCURRENCY__BATCH_SIZE=4
# APP_CFG__GRPC__ENABLED=true
# APP_CFG__GRPC__HOST=0.0.0.0
# APP_CFG__GRPC__PORT=50051
# APP_CFG__GRPC__BATCH_WAIT_MS=3
# APP_CFG__GRPC__REQUEST_MODEL_NAME=asr
